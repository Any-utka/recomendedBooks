# Скопируйте этот файл в backend/.env и впишите свои значения.
# Файл .env с настоящими ключами не публикуется (он в .gitignore).

# Groq — LLM для AI-агента (обязательно). Ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Google Books API (необязательно: без ключа API работает, но с низким лимитом запросов).
# Ключ: https://console.cloud.google.com → APIs & Services → Books API → Credentials
GOOGLE_BOOKS_API_KEY=

# Gmail для отправки подборок на email (нужно только для кнопки «Отправить подборку на email»).
# SMTP_PASSWORD — пароль приложения (16 символов), а не обычный пароль от почты:
# https://myaccount.google.com/apppasswords (нужна двухэтапная проверка аккаунта)
SMTP_EMAIL=
SMTP_PASSWORD=
